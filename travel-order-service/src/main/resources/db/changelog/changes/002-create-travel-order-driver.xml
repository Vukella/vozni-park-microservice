<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002" author="vukelicnemanja">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="travel_order_driver"/></not>
        </preConditions>
        <createTable tableName="travel_order_driver">
            <column name="id_travel_order_driver" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="travel_order_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="driver_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="is_primary" type="TINYINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="travel_order_driver"
                baseColumnNames="travel_order_id"
                referencedTableName="travel_order"
                referencedColumnNames="id_travel_order"
                constraintName="fk_tod_travel_order"
                onDelete="CASCADE"/>

        <addUniqueConstraint
                tableName="travel_order_driver"
                columnNames="travel_order_id, driver_id"
                constraintName="uk_tod_travel_order_driver"/>
    </changeSet>

</databaseChangeLog>
