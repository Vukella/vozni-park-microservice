<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001" author="vukelicnemanja">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="travel_order"/></not>
        </preConditions>
        <createTable tableName="travel_order">
            <column name="id_travel_order" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="vehicle_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="date_from" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="date_to" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="work_order_number" type="VARCHAR(30)"/>
            <column name="travel_order_number" type="VARCHAR(20)"/>
            <column name="location_id" type="INT"/>
            <column name="starting_mileage" type="INT"/>
            <column name="ending_mileage" type="INT"/>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="saga_status" type="VARCHAR(30)" defaultValue="INITIATED">
                <constraints nullable="false"/>
            </column>
            <column name="failure_reason" type="VARCHAR(500)"/>
            <column name="created_by_user_id" type="BIGINT"/>
            <column name="created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME(6)"/>
        </createTable>

        <addUniqueConstraint
                tableName="travel_order"
                columnNames="work_order_number"
                constraintName="uk_travel_order_work_order_number"/>
    </changeSet>

</databaseChangeLog>
